# TraceFlow Backend Configuration

# Server Port
PORT=5000

# MongoDB Connection String (Replace with your MongoDB Atlas or local MongoDB URI)
# Example MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/traceflow?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/traceflow?retryWrites=true&w=majority

# Node Environment
NODE_ENV=development

# Allowed CORS Origins (Frontend dashboard & demo site)
CLIENT_URL=http://localhost:5173
DEMO_URL=http://localhost:3000
